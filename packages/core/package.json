{
  "name": "@codexly/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#undici": {
      "types": "undici",
      "default": "undici/index.js"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./persistent-historical-attachment-store": {
      "types": "./src/persistent-historical-attachment-store.ts",
      "default": "./src/persistent-historical-attachment-store.ts"
    },
    "./historical-attachment-worker-pool": {
      "types": "./src/historical-attachment-worker-pool.ts",
      "default": "./src/historical-attachment-worker-pool.ts"
    },
    "./historical-attachment-files": {
      "types": "./src/historical-attachment-files.ts",
      "default": "./src/historical-attachment-files.ts"
    },
    "./historical-image-media-type": {
      "types": "./src/historical-image-media-type.d.ts",
      "default": "./src/historical-image-media-type.js"
    },
    "./persistent-task-queue": {
      "types": "./src/persistent-task-queue.ts",
      "default": "./src/persistent-task-queue.ts"
    },
    "./app-storage-paths": {
      "types": "./src/app-storage-paths.ts",
      "default": "./src/app-storage-paths.ts"
    },
    "./task-attachments": {
      "types": "./src/task-attachments.ts",
      "default": "./src/task-attachments.ts"
    },
    "./direct-fetch": {
      "types": "./src/direct-fetch.ts",
      "default": "./src/direct-fetch.ts"
    },
    "./file-task-queue": {
      "types": "./src/file-task-queue.ts",
      "default": "./src/file-task-queue.ts"
    }
  },
  "dependencies": {
    "@codexly/protocol": "workspace:*",
    "undici": "catalog:"
  }
}
