{
  "name": "@codexly/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./acp-config-validation": {
      "types": "./src/acp-config-validation.ts",
      "default": "./src/acp-config-validation.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./task-queue-storage": {
      "types": "./src/task-queue-storage.ts",
      "default": "./src/task-queue-storage.ts"
    },
    "./event-common": {
      "types": "./src/event-common.ts",
      "default": "./src/event-common.ts"
    },
    "./project-entity": {
      "types": "./src/project-entity.ts",
      "default": "./src/project-entity.ts"
    },
    "./project-root": {
      "types": "./src/project-root.ts",
      "default": "./src/project-root.ts"
    },
    "./task-common": {
      "types": "./src/task-common.ts",
      "default": "./src/task-common.ts"
    },
    "./acp-scheduled-plan": {
      "types": "./src/acp-scheduled-plan.ts",
      "default": "./src/acp-scheduled-plan.ts"
    },
    "./acp-plan-api": {
      "types": "./src/acp-plan-api.ts",
      "default": "./src/acp-plan-api.ts"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:"
  }
