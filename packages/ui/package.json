{
  "name": "@codexly/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./agent/message": {
      "types": "./src/agent/message.tsx",
      "default": "./src/agent/message.tsx"
    },
    "./agent/patch-diff-viewer": {
      "types": "./src/agent/patch-diff-viewer.tsx",
      "default": "./src/agent/patch-diff-viewer.tsx"
    },
    "./agent/streaming-markdown": {
      "types": "./src/agent/streaming-markdown.tsx",
      "default": "./src/agent/streaming-markdown.tsx"
    },
    "./agent/streaming-markdown.css": "./src/agent/streaming-markdown.css",
    "./core/*": {
      "types": "./src/core/*.tsx",
      "default": "./src/core/*.tsx"
    },
    "./core/split-workspace.css": "./src/core/split-workspace.css",
    "./agent/code-block-content": {
      "types": "./src/agent/code-block-content.tsx",
      "default": "./src/agent/code-block-content.tsx"
    },
    "./agent/code-block-pages": {
      "types": "./src/agent/code-block-pages.ts",
      "default": "./src/agent/code-block-pages.ts"
    },
    "./agent/code-languages": {
      "types": "./src/agent/code-languages.ts",
      "default": "./src/agent/code-languages.ts"
    },
    "./agent/code-highlighter": {
      "types": "./src/agent/code-highlighter.ts",
      "default": "./src/agent/code-highlighter.ts"
    },
    "./agent/code-tokens": {
      "types": "./src/agent/code-tokens.ts",
      "default": "./src/agent/code-tokens.ts"
    },
    "./agent/code-block": {
      "types": "./src/agent/code-block.tsx",
      "default": "./src/agent/code-block.tsx"
    },
    "./agent/code-token-cache": {
      "types": "./src/agent/code-token-cache.ts",
      "default": "./src/agent/code-token-cache.ts"
    }
  },
  "dependencies": {
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-css": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/lang-python": "catalog:",
    "@codemirror/lang-rust": "catalog:",
    "@codemirror/lang-sql": "catalog:",
    "@codemirror/lang-xml": "catalog:",
    "@codemirror/lang-yaml": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@codexly/frontend-core": "workspace:*",
    "@pierre/diffs": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react-zoom-pan-pinch": "catalog:",
    "streamdown": "catalog:",
    "tailwind-merge": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "shiki": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
