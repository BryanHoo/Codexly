{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        "desktop-pet",
        {
          "identifier": "webview-tests",
          "description": "Test-only WebdriverIO access for native WebView tests",
          "windows": ["main", "desktop-pet"],
          "permissions": ["wdio:default", "wdio-webdriver:default", "clipboard-manager:allow-read-text"]
        },
        {
          "identifier": "terminal-protocol-tests",
          "windows": ["main"],
          "permissions": ["allow-probe-terminal-protocol", "allow-inspect-project-terminal-test"]
        }
      ]
    }
  }
}
