{
  "name": "codeagent",
  "private": true,
  "version": "0.26.1",
  "description": "A local-first desktop client for coding agents",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:legacy": "tsc -b && cross-env VITE_MACOS_LEGACY=true vite build",
    "tauri:legacy": "cross-env CODEAGENT_MACOS_PROFILE=legacy node scripts/run-tauri.mjs build",
    "test:legacy": "node --test scripts/legacy-css.test.mjs scripts/legacy-release.test.mjs scripts/legacy-regexp.test.mjs",
    "test:macos-build-output": "node --test scripts/macos-build-output.test.mjs",
    "check": "pnpm version:check && pnpm supply-chain:policy:test && pnpm check:web && pnpm check:rust",
    "codex:protocol:check": "node scripts/codex-protocol-contract.mjs",
    "codex:protocol:update": "node scripts/codex-protocol-contract.mjs --write",
    "check:rust": "pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test && pnpm performance:rust",
    "check:web": "pnpm source:lines && pnpm source:lines:test && pnpm lint && pnpm typecheck && pnpm test:run && pnpm tauri:constraints:test && pnpm test:legacy && pnpm performance:budget:test && pnpm build && pnpm performance:budget && pnpm build:legacy",
    "source:lines": "node scripts/source-lines.mjs",
    "source:lines:test": "node --test scripts/source-lines.test.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "performance:budget": "node scripts/performance-budget.mjs",
    "performance:budget:test": "node --test scripts/performance-budget.test.mjs",
    "performance:browser": "playwright test --config benchmarks/playwright.config.ts",
    "performance:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib performance_baseline --release --locked -- --ignored --nocapture --test-threads=1",
    "performance:terminal": "cross-env CODEAGENT_WEBVIEW_RELEASE=1 wdio run benchmarks/terminal/wdio.conf.ts",
    "performance:webview": "cross-env CODEAGENT_WEBVIEW_PERFORMANCE_TEST=1 CODEAGENT_WEBVIEW_RELEASE=1 wdio run wdio.conf.ts",
    "performance:webview:build": "cross-env VITE_WEBVIEW_TEST=1 node scripts/run-tauri.mjs build --features webview-tests --no-bundle --no-sign --ci --config src-tauri/tauri.webview-test.conf.json",
    "preview": "vite preview",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --locked",
    "supply-chain:policy:test": "node --test scripts/supply-chain-policy.test.mjs",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:run": "vitest run",
    "test:task-window-production": "node --test scripts/task-window-production.test.mjs",
    "test:webview": "wdio run wdio.conf.ts",
    "test:webview:build": "cross-env VITE_WEBVIEW_TEST=1 node scripts/run-tauri.mjs build --debug --features webview-tests --no-bundle --no-sign --ci --config src-tauri/tauri.webview-test.conf.json",
    "test:webview:real": "cross-env CODEAGENT_REAL_RUNTIME_TEST=1 wdio run wdio.conf.ts",
    "tauri:constraints:test": "node --test scripts/app-icon.test.mjs scripts/changelog.test.mjs scripts/codex-protocol-contract.test.mjs scripts/project-terminal.test.mjs scripts/queue-command.test.mjs scripts/run-tauri.test.mjs scripts/task-window.test.mjs scripts/webview-bridge-readiness.test.mjs scripts/windows-subsystem.test.mjs",
    "typecheck": "tsc -b",
    "version:check": "node scripts/check-version.mjs",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@pierre/diffs": "1.4.3",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "anser": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "diff": "^9.0.0",
    "i18next": "26.4.2",
    "lucide-react": "1.47.0",
    "marked": "18.0.14",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-datepicker": "9.1.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.15",
    "remend": "1.3.1",
    "shiki": "^4.4.3",
    "sonner": "2.0.8",
    "stackblur-canvas": "3.0.1",
    "streamdown": "2.6.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "14.0.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.103.2",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "1.3.0",
    "cross-env": "10.1.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "postcss": "^8.5.28",
    "postcss-preset-env": "^11.5.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "2.3.0"
  }
}
