  "catalog": {
    "version": 1,
    "sql": "\nCREATE TABLE IF NOT EXISTS managed_projects (\n  id TEXT PRIMARY KEY, name TEXT NOT NULL, path TEXT NOT NULL UNIQUE,\n  created_at TEXT NOT NULL, position INTEGER NOT NULL\n) STRICT;\nCREATE TABLE IF NOT EXISTS managed_tasks (\n  id TEXT PRIMARY KEY,\n  project_id TEXT REFERENCES managed_projects(id) ON DELETE CASCADE,\n  title TEXT NOT NULL, cwd TEXT NOT NULL,\n  provider TEXT NOT NULL, session_id TEXT,\n  updated_at REAL NOT NULL, pinned INTEGER NOT NULL CHECK(pinned IN (0,1)),\n  archived INTEGER NOT NULL CHECK(archived IN (0,1)), status TEXT NOT NULL,\n  UNIQUE(provider, session_id)\n) STRICT;\nCREATE INDEX IF NOT EXISTS managed_tasks_page ON managed_tasks(project_id, archived, updated_at DESC, id DESC);\nCREATE INDEX IF NOT EXISTS managed_tasks_pinned ON managed_tasks(project_id, archived, pinned, updated_at DESC, id DESC);\nCREATE TABLE IF NOT EXISTS managed_catalog_migration (id INTEGER PRIMARY KEY CHECK(id = 1)) STRICT;\n",
    "previewSql": "CREATE TABLE IF NOT EXISTS managed_task_previews (task_id TEXT PRIMARY KEY REFERENCES managed_tasks(id) ON DELETE CASCADE, preview TEXT NOT NULL) STRICT;"
