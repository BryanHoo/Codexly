# 镜像版本可固定为具体版本，例如 0.23.0；latest 会跟随最新稳定版。
CODEXLY_VERSION=latest
CODEXLY_PORT=3210

# 默认挂载宿主根目录。生产环境建议限制为实际项目目录。
# CODEXLY_WORKSPACE=/path/to/projects

# 默认使用 Docker 命名卷。取消注释后可复用宿主 Codex 登录和配置。
# CODEXLY_CODEX_HOME=/path/to/.codex

# 留空时每次启动生成随机配对码，并输出到容器日志。
# CODEXLY_LAN_PASSWORD=Replace-With-A-Strong-Password1!
# CODEXLY_SESSION_TTL=12h
# CODEXLY_ALLOWED_HOSTS=codexly.example.com
