{
  "schemaVersion": 2,
  "packageManager": "pnpm",
  "packages": [
    {
      "name": "root",
      "path": ".",
      "layers": ["backend"]
    },
    {
      "name": "desktop",
      "path": "desktop",
      "layers": ["frontend", "backend"]
    },
    {
      "name": "web",
      "path": "apps/web",
      "layers": ["frontend"]
    },
    {
      "name": "protocol",
      "path": "packages/protocol",
      "layers": ["shared"]
    },
    {
      "name": "core",
      "path": "packages/core",
      "layers": ["shared"]
    },
    {
      "name": "frontend-core",
      "path": "packages/frontend-core",
      "layers": ["shared"]
    },
    {
      "name": "ui",
      "path": "packages/ui",
      "layers": ["shared"]
    },
    {
      "name": "client",
      "path": "packages/client",
      "layers": ["shared"]
    },
    {
      "name": "provider-codex",
      "path": "packages/provider-codex",
      "layers": ["backend"]
    },
    {
      "name": "provider-claude",
      "path": "packages/provider-claude",
      "layers": ["backend"]
    },
    {
      "name": "server",
      "path": "packages/server",
      "layers": ["backend"]
    }
  ],
  "artifactPaths": {
    "designs": ".superwork/prd",
    "plans": ".superwork/plans",
    "specs": ".superwork/spec"
  },
  "verification": [
    "pnpm test",
    "pnpm format:check",
    "pnpm lint",
    "pnpm lint:architecture",
    "pnpm typecheck",
    "pnpm codex:schema:check",
    "pnpm test:performance",
    "pnpm build",
    "pnpm bundle:check",
    "pnpm package:check",
    "pnpm check",
    "pnpm test:e2e",
    "pnpm test:performance:browser",
    "pnpm test:claude-host",
    "pnpm --dir desktop test:run",
    "pnpm --dir desktop test:browser",
    "pnpm --dir desktop check:web",
    "pnpm --dir desktop check:rust",
    "pnpm --dir desktop check"
  ]
}
