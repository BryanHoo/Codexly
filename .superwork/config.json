{
  "schemaVersion": 3,
  "packageManager": "pnpm",
  "packages": [
    {
      "name": "@bryanhu/codexly",
      "layers": ["backend"]
    },
    {
      "name": "@codexly/web",
      "layers": ["frontend"]
    },
    {
      "name": "@codexly/client",
      "layers": ["frontend"]
    },
    {
      "name": "@codexly/core",
      "layers": ["backend"]
    },
    {
      "name": "@codexly/protocol",
      "layers": ["shared"]
    },
    {
      "name": "@codexly/provider-codex",
      "layers": ["backend"]
    },
    {
      "name": "@codexly/server",
      "layers": ["backend"]
    }
  ],
  "artifactPaths": {
    "designs": ".superwork/prd",
    "plans": ".superwork/plans",
    "specs": ".superwork/spec"
  },
  "verification": [
    "pnpm run format:check",
    "pnpm run lint",
    "pnpm run lint:architecture",
    "pnpm run typecheck",
    "pnpm run test",
    "pnpm run test:performance",
    "pnpm run build",
    "pnpm run bundle:check",
    "pnpm run package:check",
    "pnpm run test:e2e",
    "pnpm run check"
  ]
}
